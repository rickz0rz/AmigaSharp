<Project>
  <!--
    Build-time translation for a launcher program. With the properties EmbeddedProgram (an executable),
    EmbeddedListing (its vasm listing, optional) and EmbeddedKnownCode (a map of the code that ran, optional, for a
    program without a listing), the build runs the translator and compiles the translation into the program. A module initializer adds it to AmigaSharp.Host.EmbeddedPrograms. The project of the program imports this
    file and references AmigaSharp.Translator.
  -->

  <!-- The paths are set in a target: IntermediateOutputPath has its last value (with the runtime identifier) only then. -->
  <Target Name="SetEmbeddedProgramPaths" BeforeTargets="TranslateEmbeddedProgram;AddEmbeddedProgram">
    <PropertyGroup>
      <EmbeddedProgramSource>$(ProjectDir)$(IntermediateOutputPath)EmbeddedProgram.g.cs</EmbeddedProgramSource>
      <EmbeddedProgramRegistry>$(ProjectDir)$(IntermediateOutputPath)EmbeddedProgramRegistration.g.cs</EmbeddedProgramRegistry>
    </PropertyGroup>
  </Target>

  <Target Name="TranslateEmbeddedProgram" AfterTargets="ResolveProjectReferences" BeforeTargets="CoreCompile"
          DependsOnTargets="SetEmbeddedProgramPaths" Condition="'$(EmbeddedProgram)' != ''"
          Inputs="$(EmbeddedProgram);$(EmbeddedListing);$(EmbeddedKnownCode)" Outputs="$(EmbeddedProgramSource)">
    <ItemGroup>
      <_Translator Include="@(_ResolvedProjectReferencePaths)" Condition="'%(Filename)' == 'AmigaSharp.Translator'" />
    </ItemGroup>
    <PropertyGroup>
      <_ListingOption Condition="'$(EmbeddedListing)' != ''">--listing &quot;$(EmbeddedListing)&quot;</_ListingOption>
      <_KnownCodeOption Condition="'$(EmbeddedKnownCode)' != ''">--known-code &quot;$(EmbeddedKnownCode)&quot;</_KnownCodeOption>
    </PropertyGroup>
    <Error Condition="'@(_Translator)' == ''" Text="The build did not find the translator." />
    <Exec Command="dotnet &quot;@(_Translator)&quot; &quot;$(EmbeddedProgram)&quot; $(_ListingOption) $(_KnownCodeOption) --namespace AmigaSharp.Embedded --class EmbeddedProgram --output &quot;$(EmbeddedProgramSource)&quot;" />
  </Target>

  <Target Name="AddEmbeddedProgram" AfterTargets="TranslateEmbeddedProgram" BeforeTargets="CoreCompile"
          DependsOnTargets="SetEmbeddedProgramPaths" Condition="'$(EmbeddedProgram)' != ''">
    <GetFileHash Files="$(EmbeddedProgram)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_EmbeddedProgramHash" />
    </GetFileHash>
    <PropertyGroup>
      <_Registry>namespace AmigaSharp.Embedded%3B

static class EmbeddedProgramRegistration
{
    [System.Runtime.CompilerServices.ModuleInitializer]
    internal static void Register() =&gt;
        AmigaSharp.Host.EmbeddedPrograms.Add(&quot;$(_EmbeddedProgramHash)&quot;, core =&gt; new EmbeddedProgram(core))%3B
}</_Registry>
    </PropertyGroup>
    <WriteLinesToFile File="$(EmbeddedProgramRegistry)" Lines="$(_Registry)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(EmbeddedProgramSource);$(EmbeddedProgramRegistry)" />
      <FileWrites Include="$(EmbeddedProgramSource);$(EmbeddedProgramRegistry)" />
    </ItemGroup>
  </Target>
</Project>
