Source: "tasks.s"
                            	     1: ; Starts a second process with CreateProc, as SAS/C programs do, and returns 1000 in D0 if the two tasks share the
                            	     2: ; CPU correctly.
                            	     3: ; Build: vasmm68k_mot -Fhunkexe -nosym -L tasks.lst -o tasks tasks.s
                            	     4: ;
                            	     5: ; The two tasks wait for each other in busy loops, so they work only if the scheduler switches tasks at safe points.
                            	     6: ; At the end, the child signals the main task, and the main task waits for the signal.
                            	     7: 
                            	     8: SysBase			= 4
                            	     9: _LVOFindTask		= -294
                            	    10: _LVOWait		= -318
                            	    11: _LVOSignal		= -324
                            	    12: _LVOAllocSignal		= -330
                            	    13: _LVOCloseLibrary	= -414
                            	    14: _LVOOpenLibrary		= -552
                            	    15: _LVOCreateProc		= -138
                            	    16: 
                            	    17: 			SECTION	code,CODE
                            	    18: 
00:00000000 48E73F3E        	    19: Start:			MOVEM.L	D2-D7/A2-A6,-(A7)
00:00000004 2C780004        	    20: 			MOVEA.L	SysBase,A6
00:00000008 43FA00CE        	    21: 			LEA	DosName(PC),A1
00:0000000C 7000            	    22: 			MOVEQ	#0,D0
00:0000000E 4EAEFDD8        	    23: 			JSR	_LVOOpenLibrary(A6)
00:00000012 23C000000000    	    24: 			MOVE.L	D0,DosBase
00:00000018 93C9            	    25: 			SUBA.L	A1,A1
00:0000001A 4EAEFEDA        	    26: 			JSR	_LVOFindTask(A6)
00:0000001E 23C000000004    	    27: 			MOVE.L	D0,MainTask
00:00000024 70FF            	    28: 			MOVEQ	#-1,D0
00:00000026 4EAEFEB6        	    29: 			JSR	_LVOAllocSignal(A6)
00:0000002A 7200            	    30: 			MOVEQ	#0,D1
00:0000002C 01C1            	    31: 			BSET	D0,D1
00:0000002E 23C10000000C    	    32: 			MOVE.L	D1,Mask
                            	    33: 
                            	    34: ; The segment list is a BPTR to a long that has the next segment (none), and the code follows it.
00:00000034 263C00000004    	    35: 			MOVE.L	#SegmentList+4,D3
00:0000003A E48B            	    36: 			LSR.L	#2,D3
00:0000003C 223C000000E4    	    37: 			MOVE.L	#ChildName,D1
00:00000042 7400            	    38: 			MOVEQ	#0,D2
00:00000044 283C00001000    	    39: 			MOVE.L	#4096,D4
00:0000004A 2C7900000000    	    40: 			MOVEA.L	DosBase,A6
00:00000050 4EAEFF76        	    41: 			JSR	_LVOCreateProc(A6)
                            	    42: 
                            	    43: ; Wait in a busy loop until the child runs, then let it continue.
00:00000054 4AB900000010    	    44: .spin:			TST.L	Started
00:0000005A 67F8            	    45: 			BEQ.S	.spin
00:0000005C 23FC000000010000	    46: 			MOVE.L	#1,Go
00:00000064 0014
                            	    47: 
                            	    48: ; Wait for the signal of the child.
00:00000066 2C780004        	    49: 			MOVEA.L	SysBase,A6
00:0000006A 20390000000C    	    50: 			MOVE.L	Mask,D0
00:00000070 4EAEFEC2        	    51: 			JSR	_LVOWait(A6)
                            	    52: 
00:00000074 227900000000    	    53: 			MOVEA.L	DosBase,A1
00:0000007A 4EAEFE62        	    54: 			JSR	_LVOCloseLibrary(A6)
00:0000007E 203900000018    	    55: 			MOVE.L	Counter,D0
00:00000084 223900000008    	    56: 			MOVE.L	ChildTask,D1
00:0000008A B2B900000004    	    57: 			CMP.L	MainTask,D1
00:00000090 6602            	    58: 			BNE.S	.exit
00:00000092 7000            	    59: 			MOVEQ	#0,D0			;the child ran as the main task
00:00000094 4CDF7CFC        	    60: .exit:			MOVEM.L	(A7)+,D2-D7/A2-A6
00:00000098 4E75            	    61: 			RTS
                            	    62: 
                            	    63: ; The code of the child process.
00:0000009A 2C780004        	    64: Child:			MOVEA.L	SysBase,A6
