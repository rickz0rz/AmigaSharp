00:000000A0 4EAEFEDA        	    66: 			JSR	_LVOFindTask(A6)
00:000000A4 23C000000008    	    67: 			MOVE.L	D0,ChildTask
00:000000AA 23FC000000010000	    68: 			MOVE.L	#1,Started
00:000000B2 0010
00:000000B4 4AB900000014    	    69: .wait:			TST.L	Go
00:000000BA 67F8            	    70: 			BEQ.S	.wait
00:000000BC 23FC000003E80000	    71: 			MOVE.L	#1000,Counter
00:000000C4 0018
00:000000C6 227900000004    	    72: 			MOVEA.L	MainTask,A1
00:000000CC 20390000000C    	    73: 			MOVE.L	Mask,D0
00:000000D2 4EAEFEBC        	    74: 			JSR	_LVOSignal(A6)
00:000000D6 4E75            	    75: 			RTS
