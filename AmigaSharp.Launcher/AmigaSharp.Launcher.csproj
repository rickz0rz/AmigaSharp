<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AmigaSharp.Host\AmigaSharp.Host.csproj" />
    <!-- The build runs the translator for EmbeddedProgram (see EmbeddedProgram.targets). -->
    <ProjectReference Include="..\AmigaSharp.Translator\AmigaSharp.Translator.csproj" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishReadyToRun;PublishSingleFile;PublishAot" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The translator is a program, but the launcher uses it as a library: the reference builds it without a runtime
         identifier, for each runtime identifier of the launcher (see scripts/publish.sh). -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <Import Project="..\AmigaSharp.Host\EmbeddedProgram.targets" />

</Project>
